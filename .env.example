# AgentGate Environment Variables

# Vault encryption key (exactly 32 bytes for AES-256)
AGENTGATE_VAULT_KEY=change-me-to-32-byte-secret-key!

# Admin API secret
AGENTGATE_ADMIN_SECRET=change-me-admin-secret

# Agent API key (MVP: single key from env)
AGENT_API_KEY=ag_live_your_key_here

# OAuth providers (optional - for user account linking)
STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
