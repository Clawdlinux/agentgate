# AgentGate Environment Variables

# Vault encryption key (exactly 32 bytes for AES-256)
AGENTGATE_VAULT_KEY=change-me-to-32-byte-secret-key!

# Admin API secret
AGENTGATE_ADMIN_SECRET=change-me-admin-secret

# Agent API keys are now bootstrapped automatically on first boot and
# logged once to stdout (see cmd/agentgw's bootstrapAgentKey). There is no
# env var for a pre-supplied key: keys are bcrypt-hashed in SQLite, so a
# plaintext key can only be created through internal/auth.KeyStore.Create.

# OAuth providers (optional - for user account linking)
STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
